{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()"
      }
    },
    "members": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
