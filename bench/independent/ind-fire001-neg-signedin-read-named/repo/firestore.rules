rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
match /products/{id} {
  allow read: if request.auth != null;
  allow write: if request.auth.token.admin == true;
}
match /categories/{id} {
  allow read: if request.auth.uid != null;
  allow write: if request.auth.token.admin == true;
}
  }
}
