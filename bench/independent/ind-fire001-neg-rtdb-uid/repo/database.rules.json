{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "root.child('members').child($roomId).child(auth.uid).exists()",
        ".write": "root.child('members').child($roomId).child(auth.uid).exists()"
      }
    }
  }
}
