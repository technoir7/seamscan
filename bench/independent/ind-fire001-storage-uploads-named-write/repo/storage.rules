rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    match /uploads/{file} {
      allow read: if request.auth != null;
      allow create: if true;
    }
  }
}
